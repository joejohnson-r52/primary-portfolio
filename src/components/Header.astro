---
import Logo from './Logo.astro';
import { nav } from '../data/site';
import { withBase } from '../lib/url';

// Mark the nav link for the current page (and its sub-pages) with aria-current.
// In-page anchors like /#services are skipped: they aren't separate pages.
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  const target = href.replace(/\/$/, '');
  return path === target || path.startsWith(`${target}/`);
};
---

<header class="header">
  <div class="container inner">
    <Logo />
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li class="nav-item">
              <a class="link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="btn btn-ghost cta" href={withBase('/contact')}>Get in touch</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--obsidian) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    animation: header-in 0.6s var(--ease) both;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 76px;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item a {
    color: var(--text-body);
    font-size: 15px;
    padding-block: 4px;
  }

  .nav-item a:hover,
  .nav-item a[aria-current='page'] {
    color: var(--text);
  }

  .cta {
    min-height: 44px;
    font-size: 15px;
    padding: 0 18px;
  }

  @media (max-width: 760px) {
    .nav-item {
      display: none;
    }
  }

  @keyframes header-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
</style>
