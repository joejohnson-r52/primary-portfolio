---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <p class="label">// contact</p>
    <h2 class="reveal">Got something to build?<br /><span class="dim">Let's talk.</span></h2>
    <a class="email link reveal" href={`mailto:${site.email}`}>
      {site.email} <span class="arrow" aria-hidden="true">→</span>
    </a>
    <div class="bottom">
      <ul>
        <li><a class="link" href={site.links.github}>GitHub</a></li>
        <li><a class="link" href={site.links.linkedin}>LinkedIn</a></li>
        {site.links.cv && <li><a class="link" href={site.links.cv}>CV</a></li>}
      </ul>
      <p class="label">© {year} {site.fullName}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-2);
    border-top: 1px solid var(--border);
    padding-block: var(--section-pad) 40px;
  }

  h2 {
    margin-top: 16px;
    font-size: clamp(40px, 6.5vw, 80px);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .dim {
    color: var(--text-dim);
  }

  .email {
    display: inline-block;
    margin-top: 32px;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--accent);
  }

  .bottom {
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    display: inline-block;
    padding-block: 10px;
    color: var(--text-body);
  }
</style>
