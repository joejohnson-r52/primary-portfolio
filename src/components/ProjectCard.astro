---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  large?: boolean;
  // Heading level, so the card fits the outline of the page it sits on.
  headingLevel?: 2 | 3;
}

const { project, large = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { title, summary, year, role, tech, cover, coverAlt } = project.data;
---

<article class:list={['card', 'project', 'reveal', { large }]}>
  <a href={withBase(`/projects/${project.id}`)} class="shot" tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 800px" />
      ) : (
        <span class="placeholder mono">screenshot</span>
      )
    }
  </a>
  <div class="body">
    <p class="label">{year} · {role}</p>
    <Heading class="heading"><a class="title" href={withBase(`/projects/${project.id}`)}>{title} <span class="arrow" aria-hidden="true">→</span></a></Heading>
    <p class="summary">{summary}</p>
    <ul class="chips">{tech.map((t) => <li>{t}</li>)}</ul>
  </div>
</article>

<style>
  .project {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .large {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
  }

  .shot {
    display: block;
    text-decoration: none;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface-3);
    border-bottom: 1px solid var(--border);
  }

  .large .shot {
    aspect-ratio: auto;
    min-height: 360px;
    border-bottom: 0;
    border-right: 1px solid var(--border);
  }

  .shot :global(img),
  .placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .placeholder {
    display: grid;
    place-items: center;
    color: var(--text-dim);
    font-size: 13px;
  }

  .large:hover .shot :global(img),
  .large:hover .placeholder {
    transform: scale(1.035);
  }

  .body {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px;
  }

  .large .body {
    padding: 40px;
    align-content: center;
  }

  .heading {
    font-size: 22px;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .large .heading {
    font-size: 30px;
  }

  .title {
    text-decoration: none;
  }

  .title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project {
    position: relative;
  }

  .summary {
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .large {
      grid-template-columns: 1fr;
    }

    .large .shot {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .large .body {
      padding: 28px;
    }
  }
</style>
