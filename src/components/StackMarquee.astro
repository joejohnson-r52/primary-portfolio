---
import { stack } from '../data/site';

// Every technology from the stack table, as one scrolling strip.
const items = [...new Set(stack.flatMap((row) => row.items.split(',').map((item) => item.trim())))];
---

<!-- Decorative: the same list is in the stack table further down the page. -->
<div class="marquee" aria-hidden="true">
  <div class="track">
    {
      [0, 1].map((copy) => (
        <ul class:list={['set', { copy: copy === 1 }]}>
          {items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--border);
    padding-block: 22px;
    /* Fade the strip out at both edges. */
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    animation: fade-up 0.8s var(--ease) 1.25s both;
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 45s linear infinite;
  }

  @media (hover: hover) {
    .marquee:hover .track {
      animation-play-state: paused;
    }
  }

  .set {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Accent dot between items (and after the last, so the loop seam matches). */
  li::after {
    content: '';
    width: 5px;
    height: 5px;
    margin-inline: 28px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }

  /* The second copy makes the loop seamless; -50% moves exactly one copy. */
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Without motion, show one copy that wraps instead of scrolling. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
    }

    .track {
      width: auto;
      padding-inline: var(--gutter);
    }

    .set {
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 28px;
      flex-shrink: 1;
    }

    /* Dots would trail at the end of each wrapped line. */
    li::after {
      display: none;
    }

    .copy {
      display: none;
    }
  }
</style>
