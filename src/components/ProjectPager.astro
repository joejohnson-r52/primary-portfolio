---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pager" aria-label="More projects">
      {prev && (
        <a class="card item prev" href={withBase(`/projects/${prev.id}`)} rel="prev">
          <span class="label">
            <span class="arrow" aria-hidden="true">←</span> Previous
          </span>
          <span class="title">{prev.data.title}</span>
        </a>
      )}
      {next && (
        <a class="card item next" href={withBase(`/projects/${next.id}`)} rel="next">
          <span class="label">
            Next <span class="arrow" aria-hidden="true">→</span>
          </span>
          <span class="title">{next.data.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .item {
    display: grid;
    gap: 8px;
    padding: 24px 28px;
    text-decoration: none;
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  .title {
    color: var(--text);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  /* The shared arrow nudge points right; the "previous" arrow should move left. */
  @media (hover: hover) {
    .prev:hover .arrow {
      transform: translateX(-5px);
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .next {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
