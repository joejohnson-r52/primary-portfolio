---
interface Props {
  label: string;
  title: string;
  intro?: string;
}

const { label, title, intro } = Astro.props;
---

<section class="page-head spotlight">
  <div class="container">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    padding-block: clamp(64px, 10vw, 112px) 56px;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(44px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    animation: fade-up 0.8s var(--ease) both;
  }

  .intro {
    max-width: 52ch;
    margin-top: 24px;
    font-size: clamp(18px, 2vw, 20px);
    animation: fade-up 0.8s var(--ease) 0.15s both;
  }
</style>
