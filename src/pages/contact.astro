---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
---

<Base title="Contact" description="Get in touch with Joe Johnson about a project.">
  <PageHead
    label="// contact"
    title="Tell me what you're building."
    intro="A few lines is enough: what it is, who it's for and when you need it. I reply within two working days."
  >
    <p class="status"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
  </PageHead>

  <section class="section divider">
    <div class="container grid">
      <a class="card option" href={`mailto:${site.email}`}>
        <span class="label">Email</span>
        <span class="value">{site.email}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="card option" href={site.links.linkedin}>
        <span class="label">LinkedIn</span>
        <span class="value">Connect</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="card option" href={site.links.github}>
        <span class="label">GitHub</span>
        <span class="value">See the code</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 6px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 14px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .option {
    display: grid;
    gap: 8px;
    padding: 32px;
    text-decoration: none;
  }

  .value {
    color: var(--text);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.4px;
    overflow-wrap: anywhere;
  }

  .option .arrow {
    color: var(--accent);
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
