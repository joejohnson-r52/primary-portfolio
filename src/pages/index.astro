---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceList from '../components/ExperienceList.astro';
import StackTable from '../components/StackTable.astro';
import StackMarquee from '../components/StackMarquee.astro';
import { site, services, steps, about, quote } from '../data/site';
import { withBase } from '../lib/url';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const flagship = projects.find((p) => p.data.flagship) ?? projects[0];
const others = projects.filter((p) => p !== flagship).slice(0, 2);
---

<Base>
  <section class="hero">
    <div class="container">
      <p class="prompt mono">
        <span class="typed">~/joe-johnson $ whoami</span><span class="cursor" aria-hidden="true"></span>
      </p>
      <p class="status"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
      <h1>
        <span class="line"><span>I build software</span></span>
        <span class="line dim"><span>that ships.</span></span>
      </h1>
      <p class="intro">
        I'm Joe, a full-stack developer. I build, develop and look after AI powered web applications and APIs for teams
        that need them to work.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={withBase('/contact')}>Start a project <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={withBase('/projects')}>See my work</a>
      </div>
    </div>
  </section>

  <StackMarquee />

  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <p class="label">// what i do</p>
        <h2 class="reveal">Four things, done properly.</h2>
      </div>
      <div class="grid-2">
        {
          services.map((s) => (
            <article class="card service reveal">
              <span class="icon-tile">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container">
      <div class="section-head head-row">
        <div>
          <p class="label">// selected work</p>
          <h2 class="reveal">Recent projects.</h2>
        </div>
        <a class="link more" href={withBase('/projects')}>All projects <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="work">
        {flagship && <ProjectCard project={flagship} large />}
        <div class="grid-2">{others.map((p) => <ProjectCard project={p} />)}</div>
      </div>
    </div>
  </section>

  <section class="section" id="process">
    <div class="container">
      <div class="section-head">
        <p class="label">// how i work</p>
        <h2 class="reveal">Four steps. No surprises.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class="reveal">
              <span class="label">0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-head head-row">
        <div>
          <p class="label">// experience</p>
          <h2 class="reveal">Where I've worked.</h2>
        </div>
        {
          site.links.cv && (
            <a class="link more" href={site.links.cv}>
              Full CV <span class="arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
      <ExperienceList />
    </div>
  </section>

  <section class="section" id="about">
    <div class="container about">
      <div>
        <p class="label">// about</p>
        <h2 class="reveal">A little about me.</h2>
        <div class="about-copy">
          {about.paragraphs.map((p) => <p class="reveal">{p}</p>)}
        </div>
      </div>
      <div>
        <p class="label stack-label">// stack</p>
        <StackTable />
      </div>
    </div>
  </section>

  <section class="section" id="kind-words">
    <div class="container">
      <figure class="quote reveal">
        <p class="label">// kind words</p>
        <blockquote>“{quote.text}”</blockquote>
        <figcaption>
          <span class="name">{quote.name}</span>
          <span class="label">{quote.role}</span>
        </figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(72px, 12vw, 140px) var(--section-pad);
  }

  .prompt {
    font-size: 15px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 22ch;
    animation: type 0.9s steps(22) 0.2s both;
  }

  @keyframes type {
    from {
      width: 0;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 6px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-body);
    animation: fade-up 0.7s var(--ease) 0.5s both;
  }

  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--status);
    animation: pulse 2s var(--ease) infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  h1 {
    margin-top: 28px;
    font-size: clamp(48px, 8.4vw, 116px);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .line > span {
    display: inline-block;
    animation: rise 0.9s var(--ease) 0.55s both;
  }

  .line + .line > span {
    animation-delay: 0.68s;
  }

  .dim {
    color: var(--text-dim);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  .intro {
    max-width: 38ch;
    margin-top: 32px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.5;
    animation: fade-up 0.8s var(--ease) 0.95s both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
    animation: fade-up 0.8s var(--ease) 1.1s both;
  }

  /* Shared grids */
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
  }

  .head-row h2 {
    margin-top: 16px;
  }

  .more {
    color: var(--text);
    padding-block: 10px;
  }

  /* Services */
  .service {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 32px;
  }

  .icon-tile {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--surface-3);
    color: var(--accent);
    margin-bottom: 8px;
    transition: transform 0.4s var(--ease);
  }

  @media (hover: hover) {
    .service:hover .icon-tile {
      transform: rotate(-8deg);
    }
  }

  .service p {
    font-size: 16px;
  }

  /* Work */
  .work {
    display: grid;
    gap: 20px;
  }

  /* Steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
    border-top: 1px solid var(--border-strong);
  }

  .steps p {
    font-size: 16px;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 64px;
  }

  .about h2 {
    margin-top: 16px;
  }

  .about-copy {
    display: grid;
    gap: 18px;
    margin-top: 28px;
    font-size: 18px;
  }

  .stack-label {
    margin-bottom: 20px;
  }

  /* Quote */
  .quote {
    margin: 0 auto;
    max-width: 820px;
    text-align: center;
    display: grid;
    gap: 28px;
  }

  blockquote {
    margin: 0;
    color: var(--text);
    font-size: clamp(24px, 3.2vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 500;
  }

  figcaption {
    display: grid;
    gap: 4px;
  }

  .name {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .grid-2,
    .about {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .about {
      gap: 48px;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
