---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, stack } from '../data/site';
import { withBase } from '../lib/url';

// Same curve as --ease in global.css. Built-in fade() cannot take an easing.
const ease = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
const fadeMain = {
  forwards: {
    old: { name: 'astroFadeOut', duration: '0.28s', easing: ease, fillMode: 'both' },
    new: { name: 'astroFadeIn', duration: '0.4s', easing: ease, fillMode: 'both' },
  },
  backwards: {
    old: { name: 'astroFadeOut', duration: '0.28s', easing: ease, fillMode: 'both' },
    new: { name: 'astroFadeIn', duration: '0.4s', easing: ease, fillMode: 'both' },
  },
};

interface Props {
  title?: string;
  description?: string;
  // Root-relative path or absolute URL of the social preview image.
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  // Extra JSON-LD nodes for this page, merged into the site-wide graph.
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  type = 'website',
  noindex = false,
  schema = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${site.fullName}` : `${site.fullName} · Full-stack developer for web apps and APIs`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (path: string) => new URL(path.startsWith('http') ? path : withBase(path), Astro.site).href;
const imageUrl = absolute(image);
const home = absolute('/');

// Placeholder profile links (still marked TODO in site.ts) are left out.
const sameAs = [site.links.github, site.links.linkedin].filter((url) => !url.includes('your-handle'));
// Person details for search engines, taken from the experience collection and the stack table.
const experience = await getCollection('experience');
const worksFor = [...new Set(experience.filter((e) => e.data.end === 'Present').map((e) => e.data.company))];
const alumniOf = [...new Set(experience.filter((e) => e.data.role === 'Student').map((e) => e.data.company))];
const knowsAbout = stack.flatMap((row) => row.items.split(',').map((item) => item.trim()));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${home}#person`,
      name: site.fullName,
      jobTitle: 'Full-stack developer',
      description: site.description,
      url: home,
      image: absolute(site.ogImage),
      email: `mailto:${site.email}`,
      address: { '@type': 'PostalAddress', addressRegion: site.city, addressCountry: 'GB' },
      worksFor: worksFor.map((name) => ({ '@type': 'Organization', name })),
      alumniOf: alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
      knowsAbout,
      sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.fullName,
      url: home,
      inLanguage: 'en',
      publisher: { '@id': `${home}#person` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      image === site.ogImage && (
        <>
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main" transition:name="content" transition:animate={fadeMain}>
      <slot />
    </main>
    <Footer />
    <script>
      // Persisted nodes can restart CSS animations. Stop the header entrance after the first page.
      document.addEventListener('astro:before-swap', () => {
        document.querySelector('header')?.style.setProperty('animation', 'none');
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 8px 14px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 8px;
    z-index: 100;
  }
</style>
